# Global environment defaults for the ELTX Chain monorepo
# Copy to .env and adjust before running scripts or apps.

# Network
CHAIN_ID=20256
NETWORK_NAME="ELTX Chain"
TREASURY_ADDRESS=0x695658fC245ABbaDD7a276fF73Ed44f7374275D1
RPC_URL=https://rpc.eltx.online
EXPLORER_URL=https://explorer.eltx.online
FAUCET_URL=https://faucet.eltx.online

# Deployment helpers
DEFAULT_DEPLOYER_KEY=
DRY_RUN=false

# Docker images
BESU_IMAGE=hyperledger/besu:24.9.0
BLOCKSCOUT_IMAGE=blockscout/blockscout:6.7.2
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine

# Uniswap liquidity seeding (used by deploy/scripts/04_seed_liquidity.ts)
LIQUIDITY_INITIAL_ELTX=10000
LIQUIDITY_INITIAL_USDTE=30000

# Faucet funding account (for reference only – never commit secrets)
FAUCET_HOT_WALLET=
